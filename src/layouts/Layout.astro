---
import Font from "astro/components/Font.astro";
import './theme.css'
import icon from "../assets/icon.webp"
import preview from '../assets/logo.png'
const title = "septentrion.dev"
const description = "Alcor's personal website for his commissioned artwork and interests"
const SITE_TITLE = 'septentrion.dev'
import sprite from './2.gif'
import {destinations} from "../components/navigation/destinations.ts";
import './layout.css'
import {Image} from "astro:assets";
interface LayoutProps {
    leftPanelClass?: string;
    middlePanelClass?: string;
    rightPanelClass?: string;
}

const {leftPanelClass = 'l l2', middlePanelClass = 's12 l8', rightPanelClass = 'l l2'}: LayoutProps = Astro.props;
---
<!--<ClientRouter fallback="none"/>-->
<html lang="en">
<head>
    <link href="../../node_modules/beercss/dist/cdn/beer.min.css" rel="stylesheet"/>
    <script type="module" is:inline src="../../node_modules/beercss/dist/cdn/beer.min.js"></script>
    <script type="module" is:inline src="../../node_modules/material-dynamic-colors/dist/cdn/material-dynamic-colors.min.js"></script>
    <meta charset="utf-8"/>
    <meta name="color-scheme" content="light dark"/>
    <link rel="icon" href={icon.src}/>
    <Font cssVariable="--font-body"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)}/>

    <!-- Primary Meta Tags -->
    <meta name="title" content={title}/>
    <meta name="description" content={description}/>
    <meta name="color-scheme" content="dark light"/>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={Astro.url}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content={new URL(preview.src, Astro.url)}/>

    <!-- Twitter -->
    <meta property="twitter:card" content="summary"/>
    <meta property="twitter:url" content={Astro.url}/>
    <meta property="twitter:title" content={title}/>
    <meta property="twitter:description" content={description}/>
    <meta property="twitter:image" content={new URL(preview.src, Astro.url)}/>

    <title>septentrion.dev</title>
</head>
<body class={"auto"}>
<nav class="space border round left-padding right-padding"
     style="width: fit-content; margin: auto;top: 1rem; z-index: 2;">
    {destinations.slice(0).map((value, index) => <a href={`/${value.path}`}>
        <button class="transparent circle large">
            <i class="large">{value.icon}</i>
        </button>
    </a>)}
</nav>
<div id="main" class="grid">
    <div class={leftPanelClass}>
        <Image alt="a gif of Alcor" src={sprite} style="width: min(100%, 12rem); height: auto; position:sticky; top: 1rem; view-transition-name: alcor-gif" />
        <a href="/" style="display: contents">
        </a>
    </div>
    <div id="content" class={middlePanelClass} style="width: 100%">
        <slot/>
    </div>
    <div style="flex: 1" class={rightPanelClass}>
        <slot name="side"/>
    </div>
</div>
</body>
</html>