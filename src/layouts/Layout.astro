---
import {ClientRouter, slide} from "astro:transitions";
import './layout.css'
import Font from "astro/components/Font.astro";
import './theme.css'
import BottomAppBar from "../components/navigation/BottomAppBar.astro";
import NavigationRail from "../components/navigation/NavigationRail.astro";
import icon from "../assets/icon.webp"
---
<html lang="en" transition:animate="none">
<head>
    <link href="https://cdn.jsdelivr.net/npm/beercss@4.0.21/dist/cdn/beer.min.css" rel="stylesheet"/>
    <script type="module" src="https://cdn.jsdelivr.net/npm/beercss@4.0.21/dist/cdn/beer.min.js"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/material-dynamic-colors@1.1.4/dist/cdn/material-dynamic-colors.min.js"></script>
    <meta charset="utf-8"/>
    <meta name="color-scheme" content="light dark"/>
    <link rel="icon" href={icon.src}/>
    <Font cssVariable="--font-body"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>septentrion.dev</title>
    <ClientRouter/>
</head>
<body class={"auto"}>
<div style="display: flex;min-height: 100dvh" class="surface-container-high adaptive-flex">
    <NavigationRail  />
    <div id="content" class="surface">
        <slot/>
    </div>
    <BottomAppBar transition:persist  />
</div>
</body>
</html>