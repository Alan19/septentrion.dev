---
import React from "react";
import {getDisplayFunction} from "./getDisplayOrder.ts";
import {Image} from "astro:assets";
import type {InferEntrySchema} from "astro:content";
import {BASE_URL} from "../../util/consts.ts";
import './skeleton.css'
import {clsx} from "clsx";
import {Rating} from "../../util/images.ts";
type Props = {
    images: InferEntrySchema<"artworks">[];
    componentWidth: number;
    targetRowHeight: number;
    rowHeightTolerance?: number;
    itemSpacing?: number;
}
const {images, itemSpacing = 16, targetRowHeight, rowHeightTolerance = .15, componentWidth} = Astro.props;
let [displayOrder, extraElement] = getDisplayFunction(images, componentWidth, rowHeightTolerance, targetRowHeight, itemSpacing);

function getBorderForRating(rating: Rating) {
    switch (rating) {
        case Rating.Mainstream:
        case Rating.General:
            return "primary-border"
        case Rating.Sensitive:
            return "yellow-border";
        case Rating.Mature:
            return "error-border";
    }
}
---
<script is:inline data-astro-rerun>
    // noinspection ES6ConvertVarToLetConst We are using var so that the script can reinject the listener for dynamic back behavior
    var feedLinks = document.querySelectorAll('.image-link')
    console.debug("Adding listeners")
    feedLinks.forEach((feedLink) => {
        feedLink?.addEventListener('click', () => {
            localStorage.setItem('cameFromGallery', 'true')
        })
    })
</script>
<div style={{display: "flex", flexDirection: "column", gap: itemSpacing + "px"}}>
    {displayOrder.map((value, index, array) =>
            <div style={{display: "flex", gap: itemSpacing + "px"}}>
                {value.map((imageEntry, _index, array) =>
                        <div style={{flex: (array.length === 1 ? 1 : imageEntry.aspectRatio)}}>
                            <a style={{display: "contents"}} href={`${BASE_URL}/gallery/artwork/${imageEntry.id}`} class="image-link">
                                    <img alt={imageEntry.title}
                                           loading={"eager"}
                                           class={clsx("border no-round skeleton", getBorderForRating(imageEntry.rating))}
                                           src={imageEntry.webp}
                                           transition:name={`img-${imageEntry.id}`}
                                           transition:animate={"fade"}
                                           style={{width: "100%", height: "fit-content", viewTransitionClass: "gallery-img", aspectRatio: imageEntry.aspectRatio}}/>
                            </a>
                        </div>)}
                {(index === array.length - 1) && !!(extraElement) &&
                        <div style={{flex: extraElement}}></div>}
            </div>)}
</div>
