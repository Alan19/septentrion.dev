---
import {getDisplayFunction} from "./getDisplayOrder.ts";
import type {InferEntrySchema} from "astro:content";
import {BASE_URL} from "../../util/consts.ts";
import {Image} from "astro:assets";
import './skeleton.css'
import {clsx} from "clsx";
import '../../pages/gallery/gallery.css'

import {Rating} from "../../util/rating.ts";
import _ from "lodash";
import dayjs from "dayjs";

type Props = {
    images: InferEntrySchema<"artworks">[];
    componentWidth: number;
    targetRowHeight: number;
    rowHeightTolerance?: number;
    itemSpacing?: number;
}
const {images} = Astro.props;

function getBorderForRating(rating: Rating) {
    switch (rating) {
        case Rating.Mainstream:
        case Rating.General:
            return "primary-border"
        case Rating.Sensitive:
            return "yellow-border";
        case Rating.Mature:
            return "error-border";
    }
}
---
<script is:inline data-astro-rerun>
    // noinspection ES6ConvertVarToLetConst We are using var so that the script can reinject the listener for dynamic back behavior
    var feedLinks = document.querySelectorAll('.image-link')
    console.debug("Adding listeners")
    feedLinks.forEach((feedLink) => {
        feedLink?.addEventListener('click', () => {
            localStorage.setItem('cameFromGallery', 'true')
        })
    });

    var element = document.querySelector('#monthly-switch');
    console.log(element)
    element.addEventListener('change', (event) => {
        console.log('onchange',event.target )
        if (event.target.value === 'checked') {
            document.querySelector('#non-monthly-gallery').style.display = 'none';
            document.querySelector('#monthly-gallery').style.display = 'block';
        }
        else {
            document.querySelector('#non-monthly-gallery').style.display = 'flex';
            document.querySelector('#monthly-gallery').style.display = 'none';
        }
    })
</script>
<div class="field middle-align">
    <nav>
        <h6>Monthly mode</h6>
        <label class="switch">
            <input type="checkbox" id="monthly-switch">
            <span></span>
        </label>
    </nav>
</div>
<div id="monthly-gallery">
    {_.uniq(images.map(value => value.published.substring(0, 7)).sort((a, b) => b.localeCompare(a))).map(value => <h3>
            {dayjs(value).format("MMMM YYYY")}
            </h3>
                    <div class="gallery-mosaic">
                        {images.filter(value1 => {
                            return value1.published.substring(0, 7) === value;
                        }).map(imageEntry => <a style={{display: "contents"}} href={`${BASE_URL}/gallery/artwork/${imageEntry.id}`} class="image-link">
                            <figure>
                                <Image width={1200}
                                       height={1200 / imageEntry.aspectRatio}
                                       format="webp"
                                       alt={imageEntry.title}
                                       class={clsx("border no-round gallery-img", getBorderForRating(imageEntry.rating))}
                                       src={imageEntry.webp}
                                       style={{viewTransitionClass: "gallery-img"}}/>
                            </figure>
                        </a>)}
                    </div>
    )}
</div>
<div class="gallery-mosaic" id="non-monthly-gallery" style="display: none">
    {images.map(imageEntry => <a style={{display: "contents"}} href={`${BASE_URL}/gallery/artwork/${imageEntry.id}`} class="image-link">
        <figure>
            <Image width={1200}
                   height={1200 / imageEntry.aspectRatio}
                   format="webp"
                   alt={imageEntry.title}
                   class={clsx("border no-round gallery-img", getBorderForRating(imageEntry.rating))}
                   src={imageEntry.thumbnailUrl}
                   style={{viewTransitionClass: "gallery-img"}}/>
        </figure>
    </a>)}
</div>