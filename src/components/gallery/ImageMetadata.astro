---
import Image from "astro/components/Image.astro";
import _ from "lodash";
import type {InferEntrySchema} from "astro:content";
import {Rating} from "../../util/rating.ts";
import {getDisplayFunction} from "./getDisplayOrder.ts";
type Props = {
    artist: string,
    rating: Rating,
    tags: string[],
    characters: string[],
    published: string,
    alts: InferEntrySchema<"artworks">["alts"],
    parentWebp: string,
    parentAspectRatio: number
}
const {artist, rating, tags, characters, published, alts, parentWebp, parentAspectRatio} = Astro.props;
const artistUrl = !artist.includes('.') ? `https://x.com/${artist}` : `https://bsky.app/profile/${artist.substring(1)}`
---
<div>Artist: <a class="link" href={artistUrl} target="_blank" rel="noopener noreferrer">{artist}</a></div>
<div>Rating: {_.capitalize(rating)}</div>
<div>Published: {published}</div>
<h6>Characters</h6>
<div style="margin-top: 0; display: flex; flex-wrap: wrap; gap: .5rem">
    {characters.map(tag =>
            <button class="chip">
                <span>{tag}</span>
            </button>)}
</div>
<h6>Tags</h6>
<div style="margin-top: 0; display: flex; flex-wrap: wrap; gap: .5rem">
    {tags.map(tag =>
            <button class="chip">
                <span>{tag}</span>
            </button>)}
</div>
{!!alts.length &&
<>
    <h5>Alts</h5>

    <div style="display: flex; flex-direction: column; gap: .5rem">
        <Image src={parentWebp}
               alt={'parent image'}
               onclick={`const el = document.getElementById('artwork');el.src = '${parentWebp}'`}
               class={'artwork-alt'}
               width={400}
               height={800}/>
        {alts.map(value =>
                <Image src={value.webp}
                       alt={value.parent + ' alt'}
                       onclick={`const el = document.getElementById('artwork');el.src = '${value.webp}'`}
                       class={'artwork-alt'}
                       width={400}
                       height={800}/>)}
    </div>
</>}
