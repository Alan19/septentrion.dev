<script>
    import {supportsViewTransitions} from 'astro:transitions/client'

    if (supportsViewTransitions) {
        document.addEventListener('astro:page-load', callback)
    } else {
        callback()
    }

    function callback() {
        const backButton = document.querySelector('.gallery-link')
        const fromFeed = localStorage.getItem('cameFromGallery')
        localStorage.removeItem('cameFromGallery')

        backButton?.addEventListener('click', (e) => {
            if (fromFeed && history.length > 1) {
                e.preventDefault()
                history.back()
            }
        })
    }
</script>