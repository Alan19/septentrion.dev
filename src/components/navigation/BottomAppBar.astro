---
import {destinations} from "./destinations.ts";
import {BASE_URL} from "../../util/consts.ts";
import clsx from "clsx"

const path = Astro.url.pathname.split('/').at(1) ?? '';
// TODO Switch to navigation drawer since there's too many destinations
---
<footer class="s surface-container-high" style="position: sticky; bottom: 0" transition:name="bottom-app-bar">
    <nav style={{display: "flex", justifyContent: "space-evenly", alignItems: "stretch"}}>
        {destinations.map(value => {
            const subpath = value.matches ?? value.path;
            return <a href={`${BASE_URL}/${value.path}`} style={{display: "flex", flexDirection: "column", flex: "1 1 0"}}>
                <button class={clsx("destination-icon", path === subpath ? 'secondary-container' : 'transparent')}>
                    <i>{value.icon}</i>
                </button>
                <span class={clsx(path === subpath && 'bold')}>{value.name}</span>
            </a>;
        })}

    </nav>
</footer>