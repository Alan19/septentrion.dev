---
import Layout from "../layouts/Layout.astro";
import logo from "../assets/logo.png"
import Image from "astro/components/Image.astro";
import SocialMediaLinks from "../components/SocialMediaLinks.astro";
import './index.css'
---
<Layout>
    <div>
        <h1 transition:animate="slide">Alcor</h1>
        <q>Cougar-dragon doing his best! ✨</q>
        <br/>
        <strong>Software Engineer 👨‍💻 ◈ TTRPG Enthusiast 🎲 ◈ CFVG Player 🎴</strong>
        <SocialMediaLinks/>
    </div>
    <div style="max-height: 36rem;">
        <Image src={logo} alt={"an image of smug Alcor by Kuttoyaki"} class={"circle primary-border border center"}
               id="index-image" width={600} height={600} style={{maxHeight: '400px', maxWidth: '400px'}}/>
    </div>
    <!--Display RSS in bottom right-->
    <a href="/rss.xml" style="display: contents">
        <button class="transparent circle s m" style="position: absolute; bottom: 1rem; right: 1rem">
            <i>rss_feed</i>
        </button>

    </a>
    <div slot="side" style="height: 100%;">
        <a href="/rss.xml" style="display: contents">
            <button class="transparent circle" style="position: absolute; bottom: 1rem; right: 1rem">
                <i>rss_feed</i>
            </button>
        </a>
    </div>
</Layout>