---
import Layout from "../layouts/Layout.astro";
import logo from "../assets/logo.png"
import Image from "astro/components/Image.astro";
import SocialMediaLinks from "../components/SocialMediaLinks.astro";
import './index.css'
---
<Layout>
    <div>
        <h1 transition:animate="slide">Alcor</h1>
        <q>Cougar-dragon doing his best! ✨</q>
        <br/>
        <strong>Software Engineer 👨‍💻 ◈ TTRPG Enthusiast 🎲 ◈ CFVG Player 🎴</strong>
        <SocialMediaLinks/>
    </div>
    <div style="max-height: 36rem;">
        <Image src={logo} alt={"an image of smug Alcor by Kuttoyaki"} class={"circle primary-border border center"} width={"500"} height={"500"} style={{width: "100%", height: "100%"}}/>
    </div>
</Layout>