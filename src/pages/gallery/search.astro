---
import Layout from "../../layouts/Layout.astro";
import {getCollection} from "astro:content";
import {FilteredGallery} from "../../components/gallery/FilteredGallery";
import {GalleryFilterContents} from "../../components/gallery/GalleryFilter";
import _ from "lodash";

const artworks = (await getCollection('artworks')).toSorted((a, b) => b.data.commissionNumber - a.data.commissionNumber)
const artists = _.uniq((await getCollection('artworks')).map(value => value.data.artist));
---
<Layout>
    <div class="container">
        <h1>Gallery</h1>
        <FilteredGallery images={artworks.map(value => value.data)} componentWidth={900} targetRowHeight={300} client:only="react"/>
    </div>
    <div id="side" class="surface l" slot="side">
        <GalleryFilterContents artists={artists} client:only="react"/>
    </div>
</Layout>