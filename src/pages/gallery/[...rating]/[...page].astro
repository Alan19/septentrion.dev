---
import type {GetStaticPaths} from "astro";
import {getCollection} from "astro:content";
import '../../pages.css'
import './gallery.css'
import {Rating, ratingToNumber} from "../../../util/images.ts";
import Layout from "../../../layouts/Layout.astro";
import Gallery from "../../../components/gallery/Gallery.astro";
import _ from "lodash";
import {GalleryFilterContents} from "../../../components/gallery/GalleryFilter.tsx";
import {isDev} from "../../../util/consts.ts";
import {clsx} from "clsx";
import { ArtUploader } from "../../../components/uploader/ArtUploader";

const artists = _.uniq((await getCollection('artworks')).map(value => value.data.artist));

export const getStaticPaths = (async ({paginate}) => {
    const galleryImages = (await getCollection('artworks')).toSorted((a, b) => b.data.commissionNumber - a.data.commissionNumber);

    return Object.values(Rating).filter(value => value !== Rating.Mature || value === Rating.Mature && isDev).flatMap(rating => {
        let filteredPosts = galleryImages.filter(image => ratingToNumber(image.data.rating) <= ratingToNumber(rating));
        return paginate(filteredPosts, {pageSize: 16, params: {rating}});
    })
}) satisfies GetStaticPaths;

// All paginated data is passed on the "page" prop
const {page} = Astro.props;
const params = Astro.params;
---
<Layout>
    <div class="container" style="width: 100%">
        <div style="display: flex">
            <h1 style="flex: 1">Gallery</h1>
            <button id="filter-button" class={"transparent circle s m"} popovertarget="filter-dialog">
                <i>filter_alt</i>
            </button>
        </div>
        <h2>Page {page.currentPage}</h2>
        <div style="display: flex; gap: 1rem">
            <!--TODO Put this into a toolbar-->
            <a class="link" style={{visibility: page.url.first ? "visible" : "hidden"}} href={page.url.first}>First</a>
            <a class="link" style={{visibility: page.url.prev ? "visible" : "hidden"}} href={page.url.prev}>Previous</a>
            <a class="link" style={{visibility: page.url.next ? "visible" : "hidden"}} href={page.url.next}>Next</a>
            <a class="link" style={{visibility: page.url.last ? "visible" : "hidden"}} href={page.url.last}>Last</a>
        </div>
        <div class="l">
            <Gallery images={page.data.map(value => value.data)} componentWidth={817} targetRowHeight={300} rowHeightTolerance={.5}/>
        </div>
        <div class="m">
            <Gallery images={page.data.map(value => value.data)} componentWidth={601} targetRowHeight={384} rowHeightTolerance={.5}/>
        </div>
        <div class="s">
            <Gallery images={page.data.map(value => value.data)} componentWidth={350} targetRowHeight={384} rowHeightTolerance={.5}/>
        </div>
    </div>
    <div id="side" class="surface l" slot="side">
        <GalleryFilterContents artists={artists} rating={params.rating} transition:persist={true} client:only="react"/>
    </div>
    <dialog class="right s m" style="max-width: 400px; border-top-left-radius: 2rem; border-bottom-left-radius: 2rem" id="filter-dialog" popover="auto" transition:name="filter-dialog">
        <GalleryFilterContents client:only="react" artists={artists} rating={params.rating}/>
    </dialog>
    {isDev && <ArtUploader client:load />}

</Layout>
