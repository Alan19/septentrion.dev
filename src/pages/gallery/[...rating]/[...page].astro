---
import type {GetStaticPaths} from "astro";
import {getCollection} from "astro:content";
import '../../pages.css'
import './gallery.css'
import {ArtistFilter} from "../../../components/gallery/ArtistFilter.tsx";
import {Rating} from "../../../util/images.ts";
import Layout from "../../../layouts/Layout.astro";
import Gallery from "../../../components/gallery/Gallery.astro";
import _ from "lodash";
import ImageMetadata from "../../../components/gallery/ImageMetadata.astro";

const artworks = Array.from(new Set((await getCollection('artworks')).map(value => value.data.artist)));

export const getStaticPaths = (async ({paginate}) => {
    const galleryImages = (await getCollection('artworks')).toSorted((a, b) => b.data.commissionNumber - a.data.commissionNumber);

    function ratingToNumber(rating: Rating): number {
        switch (rating) {
            case Rating.Mainstream:
                return 0;
            case Rating.General:
                return 1;
            case Rating.Sensitive:
                return 2;
            case Rating.Mature:
                return 3;
        }
    }

    // Generate pages from our array of astronauts, with 2 to a page
    return Object.values(Rating).flatMap(rating => {
        let filteredPosts = galleryImages.filter(image => ratingToNumber(image.data.rating) <= ratingToNumber(rating));
        return paginate(filteredPosts, {pageSize: 16, params: {rating}});
    })
}) satisfies GetStaticPaths;

// All paginated data is passed on the "page" prop
const {page} = Astro.props;
const params = Astro.params;
---
<Layout>
    <div class="container" style="width: 100%">
        <div style="display: flex">
            <h1 style="flex: 1">Gallery</h1>
            <!--<button id="filter-button" class="transparent circle primary" popovertarget="filter-dialog"><i class="fill">filter_alt</i></button>-->
        </div>
        <h2>Page {page.currentPage}</h2>
        <div style="display: flex; gap: 1rem">
            <!--TODO Put this into a toolbar-->
            <a class="link" style={{visibility: page.url.first ? "visible" : "hidden"}} href={page.url.first}>First</a>
            <a class="link" style={{visibility: page.url.prev ? "visible" : "hidden"}} href={page.url.prev}>Previous</a>
            <a class="link" style={{visibility: page.url.next ? "visible" : "hidden"}} href={page.url.next}>Next</a>
            <a class="link" style={{visibility: page.url.last ? "visible" : "hidden"}} href={page.url.last}>Last</a>
        </div>
        <div class="l">
            <Gallery images={page.data.map(value => value.data)} componentWidth={993} targetRowHeight={300} rowHeightTolerance={.5}/>
        </div>
        <div class="m">
            <Gallery images={page.data.map(value => value.data)} componentWidth={601} targetRowHeight={384} rowHeightTolerance={.5}/>
        </div>
        <div class="s">
            <Gallery images={page.data.map(value => value.data)} componentWidth={350} targetRowHeight={384} rowHeightTolerance={.5}/>
        </div>
    </div>
    <div id="side" class="surface l" slot="side">
        <div class="filter-side-sheet">
            <h3 class="secondary-text">Filters</h3>
            <h5>Artist</h5>
            <ArtistFilter client:load artists={artworks}/>
            <h5>Rating</h5>
            <div style="display: flex; gap: 8px; flex-wrap: wrap">
                {Object.values(Rating).map(value => <a href={`/gallery/${value}`}>
                    <button class="chip small">{_.capitalize(value)}</button>
                </a>)}
            </div>
            <h5>Characters</h5>
            <div style="display: flex; gap: 8px; flex-wrap: wrap">
                {['Alcor', 'Rayan', 'Giove', 'Castor', 'Soma', 'Wilton'].map(value =>
                        <button class="chip small">{_.capitalize(value)}</button>)}
            </div>
        </div>
    </div>
    <dialog class="right s m" style="width: 400px; border-top-left-radius: 2rem; border-bottom-left-radius: 2rem" id="filter-dialog" popover="auto">
        <h3 class="secondary-text">Filters</h3>
        <h5>Artist</h5>
        <ArtistFilter client:load artists={artworks}/>
        <h5>Rating</h5>
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            {Object.values(Rating).map(value => <a href={`/gallery/${value}`}>
                <button class="chip small">{_.capitalize(value)}</button>
            </a>)}
        </div>
        <h5>Characters</h5>
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            {['Alcor', 'Rayan', 'Giove', 'Castor', 'Soma', 'Wilton'].map(value =>
                    <button class="chip small">{_.capitalize(value)}</button>)}
        </div>
    </dialog>
</Layout>
