---
import images from "../../content/gallery/images.json"
import {type ImageEntry, isAltInformation, isImageInformation} from "../../util/images.ts";
import Layout from "../../layouts/Layout.astro";
import {Image} from "astro:assets";
import '../pages.css'
import './artwork.css'
import {BASE_URL} from "../../util/consts.ts";
import {getCollection} from "astro:content";
import type {GetStaticPaths} from "astro";

export async function getStaticPaths() {
    const collection = await getCollection('artworks')
    if (!collection) return [];
    return collection.map((post) => {
        return ({
            params: {id: post.id},
            props: {
                src: post.data.webp,
                title: post.data.title,
                href: post.data.href,
                id: post.id
            },
        });
    });
}

const {src, title, href, id} = Astro.props
---
<Layout>
    <div class="container">
        <div class="image-div">
            <nav style="gap: .05rem; overflow-y: hidden" class="round surface-container padding large-text">
                <a class="link underline" href={`${BASE_URL}/gallery`}>Gallery</a>
                <i>chevron_right</i>
                <span class="bold">{title}</span>
            </nav>
            <a target="_blank" rel="noopener noreferrer" style={{display: "contents"}} href={href}>
                <Image inferSize alt={title} class={"top-margin artwork"} src={src} transition:name={`img-${id}`}/>
            </a>
        </div>
    </div>
</Layout>
