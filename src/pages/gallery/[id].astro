---
import images from "../../content/gallery/images.json"
import {getCollection} from "astro:content";
import {type AltInformation, type ImageBase, type ImageEntry, isAltInformation, isImageInformation} from "../../util/images.ts";
import Layout from "../../layouts/Layout.astro";
import {Image} from "astro:assets";
import '../pages.css'
import './artwork.css'
import {BASE_URL} from "../../util/consts.ts";

export async function getStaticPaths() {
    return images.map((post) => ({
        params: {id: post.id},
        props: post,
    }));
}

const artwork: ImageEntry = Astro.props as ImageEntry;
let title: string = "";
if (isImageInformation(artwork)) {
    title = artwork.title;
} else if (isAltInformation(artwork)) {
    title = artwork.parent;
}
---
<Layout>
    <div class="container">
        {artwork &&
                <div style="display: flex; flex-direction: column;height: calc(100dvh - 96px)">
                    <nav style="gap: .05rem; overflow-y: hidden" class="round primary-container small-padding large-text tiny-space">
                        <a class="link underline" href={`${BASE_URL}/gallery`}>Gallery</a>
                        <i>chevron_right</i>
                        <span class="bold">{title}</span>
                    </nav>
                    <h2>{title}</h2>
                    <a target="_blank" rel="noopener noreferrer" style={{display: "contents"}} href={artwork.href}>
                        <Image inferSize alt={title} style={{width: "100%", height: "100%", flex: 1, objectFit: "contain", borderRadius: 0}} src={artwork.webp} transition:name={`img-${artwork.id}`}/>
                    </a>
                </div>}
    </div>
</Layout>
