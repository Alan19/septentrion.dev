---
import {ArtworkComponent} from "../../components/gallery/ArtworkComponent.tsx";
import Layout from "../../layouts/Layout.astro";
import '../pages.css'

import images from "../../content/gallery/images.json"
import {type ImageEntry, isImageInformation} from "../../util/images.ts";
import Image from "astro/components/Image.astro";
const displayedImages = (images as ImageEntry[]).filter(image => isImageInformation(image)).sort((a, b) => b.published.localeCompare(a.published))
const imageTest = displayedImages.find(value => value.id === "0bdab2747d7f4b54aba4625a415350aff2a634b527c0e1c907bc7987")
