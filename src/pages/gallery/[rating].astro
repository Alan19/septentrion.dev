---
import type {GetStaticPaths} from "astro";
import {getCollection, type InferEntrySchema} from "astro:content";
import '../pages.css'
import './gallery.css'
import {Rating, ratingToNumber} from "../../util/images.ts";
import _ from "lodash";
import {GalleryFilterContents} from "../../components/gallery/GalleryFilter.tsx";
import {isDev} from "../../util/consts.ts";
import {ArtUploader} from "../../components/uploader/ArtUploader.tsx";
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/gallery/Gallery.astro";

const artworks = await getCollection('artworks');
const artists = _.uniq(artworks.map(value => value.data.artist));

export async function getStaticPaths() {
    const artworks = (await getCollection('artworks')).toSorted((a, b) => b.data.commissionNumber - a.data.commissionNumber)

    return Object.values(Rating)
        .filter(value => value !== Rating.Mature || isDev)
        .map(rating => ({params: {rating: rating}, props: artworks.flatMap(value => value.data).filter(value => ratingToNumber(value.rating) <= ratingToNumber(rating))}));
}

const artworksForRating = Object.values(Astro.props) as InferEntrySchema<"artworks">[];
const {rating} = Astro.params;
---
<Layout>
    <div class="container" style="width: 100%">
        <div style="display: flex">
            <h1 style="flex: 1">Gallery</h1>
            <button id="filter-button" class={"transparent circle s m"} popovertarget="filter-dialog">
                <i>filter_alt</i>
            </button>
        </div>
        <div class="l">
            <Gallery images={artworksForRating.map(value => value)} componentWidth={817} targetRowHeight={300} rowHeightTolerance={.5}/>
        </div>
        <div class="m">
            <Gallery images={artworksForRating.map(value => value)} componentWidth={601} targetRowHeight={384} rowHeightTolerance={.5}/>
        </div>
        <div class="s">
            <Gallery images={artworksForRating.map(value => value)} componentWidth={350} targetRowHeight={384} rowHeightTolerance={.5}/>
        </div>
    </div>
    <div id="side" class="surface l" slot="side">
        <GalleryFilterContents artists={artists} rating={rating} transition:persist={true} client:only="react"/>
    </div>
    <dialog class="right s m" style="max-width: 400px; border-top-left-radius: 2rem; border-bottom-left-radius: 2rem" id="filter-dialog" popover="auto" transition:name="filter-dialog">
        <GalleryFilterContents client:only="react" artists={artists} rating={rating}/>
    </dialog>
    {isDev && <ArtUploader client:load/>}
</Layout>
