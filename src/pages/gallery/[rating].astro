---
import {getCollection, type InferEntrySchema} from "astro:content";
import '../pages.css'
import './gallery.css'
import _ from "lodash";
import {GalleryFilterContents} from "../../components/gallery/GalleryFilter.tsx";
import {isDev} from "../../util/consts.ts";
import {ArtUploader} from "../../components/uploader/ArtUploader.tsx";
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/gallery/Gallery.astro";
import {Rating, ratingToNumber} from "../../util/rating.ts";

const artworks = await getCollection('artworks');
const artists = _.uniq(artworks.map(value => value.data.artist));
const characters = _.uniq(artworks.flatMap(value => value.data.characters));
const tags = _.uniq(artworks.flatMap(value => value.data.tags));

export async function getStaticPaths() {
    const artworks = (await getCollection('artworks')).toSorted((a, b) => b.data.commissionNumber - a.data.commissionNumber)

    return Object.values(Rating)
        .filter(value => value !== Rating.Mature || isDev)
        .map(rating => ({
            params: {rating: rating},
            props: artworks
                .flatMap(value => value.data)
                .filter(value => ratingToNumber(value.rating) <= ratingToNumber(rating))
        }));
}

const artworksForRating = Object.values(Astro.props) as InferEntrySchema<"artworks">[];
const {rating} = Astro.params;

const rowHeight = 288;
---
<Layout middlePanelClass="s12 l7" rightPanelClass="l l3">
    <div class="container" style="width: 100%">
        <div style="display: flex">
            <h1 style="flex: 1">Gallery</h1>
            <button id="filter-button" class={"transparent circle s m"} popovertarget="filter-dialog">
                <i>filter_alt</i>
            </button>
        </div>
        <div class="top-margin">
            <div class="gallery-xl gallery-xxl">
                <Gallery images={artworksForRating.map(value => value)}
                         componentWidth={1200}
                         targetRowHeight={rowHeight}
                         rowHeightTolerance={.5}/>
            </div>
            <div class="gallery-l">
                <Gallery images={artworksForRating.map(value => value)}
                         componentWidth={1000}
                         targetRowHeight={rowHeight}
                         rowHeightTolerance={.5}/>
            </div>
            <div class="gallery-m">
                <Gallery images={artworksForRating.map(value => value)}
                         componentWidth={650}
                         targetRowHeight={rowHeight}
                         rowHeightTolerance={.5}/>
            </div>
            <div class="gallery-s">
                <Gallery images={artworksForRating.map(value => value)}
                         componentWidth={350}
                         targetRowHeight={rowHeight}
                         rowHeightTolerance={.5}/>
            </div>
        </div>
    </div>
    <article class="surface-container top-margin l" slot="side" style="max-width: 400px; margin-left: auto; position: sticky; top: 3rem">
        <GalleryFilterContents artists={artists} rating={rating} client:only="react"/>
    </article>
    <dialog class="right s m" style="max-width: 400px; border-top-left-radius: 2rem; border-bottom-left-radius: 2rem" id="filter-dialog" popover="auto">
        <GalleryFilterContents client:only="react" artists={artists} rating={rating}/>
    </dialog>
    {isDev && <ArtUploader client:load artists={artists} characters={characters} tags={tags} type="parent"/>}
</Layout>
