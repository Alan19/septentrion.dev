---
import '../../pages.css'
import './artwork.css'
import {BASE_URL} from "../../../util/consts.ts";
import {getCollection} from "astro:content";
import {clsx} from "clsx";
import _ from "lodash";
import ImageMetadata from "../../../components/gallery/ImageMetadata.astro";
import Layout from "../../../layouts/Layout.astro";
import {Image} from "astro:assets";

export async function getStaticPaths() {
    const collection = await getCollection('artworks')
    if (!collection) return [];
    return collection.map((post) => ({
        params: {id: post.id},
        props: post.data,
        cacheKey: post.digest
    }));
}

const {webp, title, href, aspectRatio, tags, artist, characters, rating, published, commissionNumber, alts} = Astro.props
const {id} = Astro.params;
---
<script>
    import {supportsViewTransitions} from 'astro:transitions/client'

    if (supportsViewTransitions) {
        document.addEventListener('astro:page-load', callback)
    } else {
        callback()
    }

    function callback() {
        const backButton = document.querySelector('.gallery-link')
        const fromFeed = localStorage.getItem('cameFromGallery')
        localStorage.removeItem('cameFromGallery')

        backButton?.addEventListener('click', (e) => {
            if (fromFeed && history.length > 1) {
                e.preventDefault()
                history.back()
            }
        })
    }
</script>
<Layout>
    <div class="container">
        <div style="display: flex; align-items: center; gap: .5rem">
            <nav style="gap: .05rem; overflow-y: hidden; flex: 1" class="round surface-container padding large-text">
                <a class="link underline gallery-link" href={`${BASE_URL}/gallery/mainstream`}>Gallery</a>
                <i>chevron_right</i>
                <span class="bold">{title}</span>
                <small class="medium-opacity bold" style="margin-left: .5rem">(#{commissionNumber})</small>
            </nav>
            <button class="m circle transparent large" popovertarget="metadata-dialog" popovertargetaction="show"><i>info</i></button>
        </div>
        <div style="display: flex; gap: 1rem" class="image-div">
            {href ? <a target="_blank" rel="noopener noreferrer" style={{display: "contents"}} href={href}>
                        <Image width={1200}
                               id="artwork"
                               height={1200}
                               alt={title}
                               class={clsx("artwork")}
                               src={webp}
                               transition:name={`img-${id}`}
                               style={{viewTransitionClass: "gallery-img", flex: 1}}/>
                    </a> :
                    <Image width={1200}
                           id="artwork"
                           height={1200}
                           alt={title}
                           class={clsx("artwork")}
                           src={webp}
                           transition:name={`img-${id}`}
                           style={{viewTransitionClass: "gallery-img", flex: 1}}/>}

        </div>
    </div>
    <div id="side" class="surface s l" slot="side">
        <div class="filter-side-sheet">
            <h5>Artwork Info</h5>
            <ImageMetadata rating={rating} artist={artist} characters={characters} tags={tags} published={published} alts={alts} parentWebp={webp} parentAspectRatio={aspectRatio}/>
        </div>
    </div>
</Layout>
<dialog class="right m" style="width: 320px" id="metadata-dialog" popover="auto">
    <div style="display: flex; gap: 1rem; margin-bottom: 1rem">
        <h5 style="flex: 1">Artwork Info</h5>
        <button class="transparent circle" popovertarget="metadata-dialog" popovertargetaction="hide"><i>close</i></button>
    </div>
    <ImageMetadata rating={rating} artist={artist} characters={characters} tags={tags} published={published} alts={alts} parentWebp={webp} parentAspectRatio={aspectRatio} />
</dialog>