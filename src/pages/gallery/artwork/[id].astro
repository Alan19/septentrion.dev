---
import '../../pages.css'
import './artwork.css'
import {BASE_URL, isDev} from "../../../util/consts.ts";
import {getCollection} from "astro:content";
import {clsx} from "clsx";
import _ from "lodash";
import ImageMetadata from "../../../components/gallery/ImageMetadata.astro";
import Layout from "../../../layouts/Layout.astro";
import { ArtUploader } from '../../../components/uploader/ArtUploader';
import {Image} from "astro:assets";
import DynamicGalleryBack from "../../../components/DynamicGalleryBack.astro";

import fs from "node:fs";
import {type AltInformation, type ImageInformation, isImageInformation} from "../../../util/images.ts";
const hiddenImages: (ImageInformation | AltInformation)[] = fs.existsSync('src/content/gallery/hidden.json') ? JSON.parse(fs.readFileSync('src/content/gallery/hidden.json').toString()) : []

const allTags = _.uniq((await getCollection('artworks')).flatMap(value => value.data.tags))
const allCharacters = _.uniq((await getCollection('artworks')).flatMap(value => value.data.characters))

export async function getStaticPaths() {
    const collection = await getCollection('artworks')
    if (!collection) return [];
    return collection.map((post) => ({
        params: {id: post.id},
        props: post.data,
        cacheKey: post.digest
    }));
}

const {
    webp,
    title,
    href,
    aspectRatio,
    tags,
    artist,
    characters,
    rating,
    published,
    commissionNumber,
    alts,
    nearLossless,
    thumbnailUrl,
    src
} = Astro.props
const {id} = Astro.params;

const maxWidthAndHeight = 1300
---
<DynamicGalleryBack />
<Layout>
    <div style="max-width: 1200px">
        <div style="display: flex; align-items: center; gap: .5rem" class="top-margin">
            <nav style="gap: .05rem; overflow-y: hidden; flex: 1" class="round surface-container padding large-text">
                <a class="link underline gallery-link" href={`${BASE_URL}/gallery/mainstream`}>Gallery</a>
                <i>chevron_right</i>
                <span class="bold">{title}</span>
                <small class="medium-opacity bold" style="margin-left: .5rem">(#{commissionNumber})</small>
            </nav>
            <button class="s m circle transparent large" popovertarget="metadata-dialog" popovertargetaction="show"><i>info</i></button>
        </div>
        {href ? <a target="_blank" rel="noopener noreferrer" style={{display: "contents"}} href={href}>
                    <Image width={maxWidthAndHeight}
                           id="artwork"
                           height={maxWidthAndHeight}
                           alt={title}
                           class={clsx("artwork")}
                           src={webp}
                           transition:name={`img-${id}`}
                           style={{viewTransitionClass: "gallery-img", flex: 1}}/>
                </a> :
                <Image width={maxWidthAndHeight}
                       id="artwork"
                       height={maxWidthAndHeight}
                       alt={title}
                       class={clsx("artwork")}
                       src={webp}
                       transition:name={`img-${id}`}
                       style={{viewTransitionClass: "gallery-img", flex: 1}}/>}
    </div>

    <article class="surface s l metadata" slot="side" style="max-width: 400px; margin: 1rem auto; overflow-y: scroll">
        <h5 style="font-weight: bold">Artwork Info</h5>
        <h6>{title} <small class="medium-opacity bold" style="margin-left: .5rem">(#{commissionNumber})</small></h6>
        <ImageMetadata rating={rating}
                       artist={artist}
                       characters={characters}
                       tags={tags}
                       published={published}
                       alts={alts}
                       parentWebp={webp}
                       parentAspectRatio={aspectRatio}/>
    </article>
    {isDev && <ArtUploader client:load characters={allCharacters} tags={allTags} type="alt" parent={{webp,
        title,
        href,
        aspectRatio,
        tags,
        artist,
        characters,
        rating,
        published,
        id,
        src,
        thumbnailUrl,
        nearLossless
    }} isParentHidden={!!hiddenImages.find(entry => isImageInformation(entry) && entry.title === title)}/>}
</Layout>
<dialog class="right" style="width: 320px" id="metadata-dialog" popover="auto">
    <div style="display: flex; gap: 1rem; margin-bottom: 1rem">
        <h5 style="flex: 1">Artwork Info</h5>
        <button class="transparent circle" popovertarget="metadata-dialog" popovertargetaction="hide"><i>close</i></button>
    </div>
    <ImageMetadata rating={rating} artist={artist} characters={characters} tags={tags} published={published} alts={alts} parentWebp={webp} parentAspectRatio={aspectRatio} />
</dialog>