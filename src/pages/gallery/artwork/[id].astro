---
import '../../pages.css'
import './artwork.css'
import {BASE_URL} from "../../../util/consts.ts";
import {getCollection} from "astro:content";
import {clsx} from "clsx";
import _ from "lodash";
import ImageMetadata from "../../../components/gallery/ImageMetadata.astro";
import Layout from "../../../layouts/Layout.astro";
import {Image} from "astro:assets";
import { ArtUploader } from '../../../components/uploader/ArtUploader';
import type {ImageInformation} from "../../../util/images.ts";

export async function getStaticPaths() {
    const collection = await getCollection('artworks')
    if (!collection) return [];
    return collection.map((post) => ({
        params: {id: post.id},
        props: post.data,
        cacheKey: post.digest
    }));
}

const {
    webp,
    title,
    href,
    aspectRatio,
    tags,
    artist,
    characters,
    rating,
    published,
    commissionNumber,
    alts,
    nearLossless,
    thumbnailUrl,
    src
} = Astro.props
const {id} = Astro.params;
---
<script>
    import {supportsViewTransitions} from 'astro:transitions/client'

    if (supportsViewTransitions) {
        document.addEventListener('astro:page-load', callback)
    } else {
        callback()
    }

    function callback() {
        const backButton = document.querySelector('.gallery-link')
        const fromFeed = localStorage.getItem('cameFromGallery')
        localStorage.removeItem('cameFromGallery')

        backButton?.addEventListener('click', (e) => {
            if (fromFeed && history.length > 1) {
                e.preventDefault()
                history.back()
            }
        })
    }
</script>
<Layout>
    <div style="display: flex; align-items: center; gap: .5rem" class="top-margin">
        <nav style="gap: .05rem; overflow-y: hidden; flex: 1" class="round surface-container padding large-text">
            <a class="link underline gallery-link" href={`${BASE_URL}/gallery/mainstream`}>Gallery</a>
            <i>chevron_right</i>
            <span class="bold">{title}</span>
            <small class="medium-opacity bold" style="margin-left: .5rem">(#{commissionNumber})</small>
        </nav>
        <button class="m circle transparent large" popovertarget="metadata-dialog" popovertargetaction="show"><i>info</i></button>
    </div>
    {href ? <a target="_blank" rel="noopener noreferrer" style={{display: "contents"}} href={href}>
                <Image width={1200}
                       id="artwork"
                       height={1200}
                       alt={title}
                       class={clsx("artwork")}
                       src={webp}
                       transition:name={`img-${id}`}
                       style={{viewTransitionClass: "gallery-img", flex: 1}}/>
            </a> :
            <Image width={1200}
                   id="artwork"
                   height={1200}
                   alt={title}
                   class={clsx("artwork")}
                   src={webp}
                   transition:name={`img-${id}`}
                   style={{viewTransitionClass: "gallery-img", flex: 1}}/>}

    <article class="surface s l metadata" slot="side" style="max-width: 400px; margin: 1rem auto; overflow-y: scroll">
        <h5 style="font-weight: bold">Artwork Info</h5>
        <h6>{title} <small class="medium-opacity bold" style="margin-left: .5rem">(#{commissionNumber})</small></h6>
        <ImageMetadata rating={rating}
                       artist={artist}
                       characters={characters}
                       tags={tags}
                       published={published}
                       alts={alts}
                       parentWebp={webp}
                       parentAspectRatio={aspectRatio}/>
    </article>
    <ArtUploader client:load characters={characters} tags={tags} type="alt" parent={{webp,
        title,
        href,
        aspectRatio,
        tags,
        artist,
        characters,
        rating,
        published,
        id,
        src,
        thumbnailUrl,
        nearLossless
    }} isParentHidden={false}/>
</Layout>
